# editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# YAML and the bats test suite follow the conventions of their ecosystems.
[*.{yml,yaml}]
indent_size = 2

[*.bats]
indent_size = 2

# Recipes are separated from their target by a tab; nothing else will do.
[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[LICENSE]
insert_final_newline = false
