{
    "about": [
        "What the API answers with, field by field, as one source both halves are held to.",
        "The container is the truth here: these shapes are read off src/Controller/ApiController.php",
        "and the models under src/Model/. dev/api.mjs is checked against them, and so is the",
        "container itself -- see tests/Contract/ApiAnswersTest.php and dev/answers.test.mjs.",
        "A type is 'string', 'int', 'bool' or 'mixed'; '?T' is that or null; '[T]' is a list of T;",
        "'@name' is one of the shapes below. Extra fields are a mismatch too: a mock that answers",
        "with more than the container does is a mock the interface is written against wrongly."
    ],
    "answers": {
        "GET /api/state": "@state",
        "GET /api/worktrees": "[@worktree]",
        "GET /api/worktrees/preview": "@preview",
        "GET /api/worktrees/{name}/commits": "@commits",
        "GET /api/worktrees/{name}/commits/{sha}": "@commitDetail",
        "GET /api/worktrees/{name}/commits/{sha}/diff": "@diff",
        "GET /api/worktrees/{name}/changes": "@changes",
        "GET /api/worktrees/{name}/changes/diff": "@diff",
        "GET /api/worktrees/{name}/usage": "@usage",
        "GET /api/worktrees/{name}/jobs": "[@jobSummary]",
        "GET /api/branches": "[@branch]",
        "GET /api/branch": "@branchDetail",
        "GET /api/branch/commits": "@commits",
        "GET /api/php-versions": "[string]",
        "GET /api/jobs/{id}": "@job"
    },
    "shapes": {
        "state": {
            "tld": "string",
            "projectName": "string",
            "branch": "string",
            "project": "?@worktree",
            "worktrees": "[@worktree]",
            "branches": "[@branch]",
            "remotes": "[string]",
            "repository": "?string",
            "phpVersions": "[string]",
            "runningJobs": "[@running]",
            "recipeProblem": "?string",
            "unconfigured": "bool",
            "updateWaiting": "bool",
            "exposed": "?string"
        },
        "worktree": {
            "name": "string",
            "branch": "string",
            "madeFor": "?string",
            "php": "string",
            "minPhp": "?string",
            "node": "?string",
            "database": "string",
            "profile": "?string",
            "docroot": "string",
            "url": "string",
            "backend": "?string",
            "path": "string",
            "changes": "int",
            "ahead": "?int",
            "behind": "?int",
            "ready": "bool",
            "isProject": "bool",
            "merged": "bool",
            "gone": "bool",
            "builtAt": "?int",
            "stale": "bool",
            "incomplete": "bool",
            "review": "?string",
            "issue": "?string",
            "issueId": "?string",
            "forkedFrom": "?string",
            "forkedAt": "?string",
            "base": "?@cut",
            "tip": "?@tip"
        },
        "cut": {
            "branch": "string",
            "own": "int",
            "moved": "int"
        },
        "tip": {
            "sha": "string",
            "subject": "string"
        },
        "branch": {
            "name": "string",
            "when": "int",
            "tip": "?@tip",
            "onRemote": "bool"
        },
        "branchDetail": {
            "name": "string",
            "when": "int",
            "tip": "?@tip",
            "onRemote": "bool",
            "base": "?@cut",
            "upstream": "?string",
            "ahead": "?int",
            "behind": "?int",
            "merged": "bool",
            "gone": "bool",
            "worktree": "?string"
        },
        "commits": {
            "upstream": "?string",
            "base": "?string",
            "more": "bool",
            "commits": "[@commit]"
        },
        "commit": {
            "sha": "string",
            "subject": "string",
            "when": "int",
            "author": "string",
            "pushed": "bool",
            "own": "bool",
            "url": "?string"
        },
        "commitDetail": {
            "sha": "string",
            "id": "string",
            "subject": "string",
            "body": "string",
            "when": "int",
            "author": "string",
            "parents": "[string]",
            "pushed": "bool",
            "files": "[@change]",
            "url": "?string"
        },
        "change": {
            "status": "string",
            "path": "string"
        },
        "changes": {
            "changes": "[@change]"
        },
        "diff": {
            "path": "string",
            "lines": "[@diffLine]",
            "truncated": "bool"
        },
        "diffLine": {
            "kind": "string",
            "text": "string"
        },
        "usage": {
